{
  "name": "@nutriwork/atlas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@quartz-community/utils": "^0.1.0",
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "atlas-ui",
    "displayName": "Nutriwork Atlas UI",
